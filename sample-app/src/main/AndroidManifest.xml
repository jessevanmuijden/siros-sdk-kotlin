<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- ISO 18013-5 BLE proximity presentation (mdoc peripheral server mode) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- mdoc central client mode: scans for a reader-advertised service UUID
         only (never derives physical location from scan results). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- BLE scanning on Android 10/11 (API 28-30) requires this classic
         permission regardless of BLUETOOTH_SCAN's neverForLocation flag,
         which only exists on API 31+ - without it, BleCentralClient's scan
         silently returns zero results on pre-S devices. ACCESS_COARSE_LOCATION
         must be requested alongside ACCESS_FINE_LOCATION (Android requires both). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:name=".SampleApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.SirosSDKSample"
        android:usesCleartextTraffic="${usesCleartextTraffic}">

        <!-- Demo screen for the circuit_zk presenter; own launcher icon, no login. -->
        <activity
            android:name=".nymdemo.NymAuthDemoActivity"
            android:label="Nym demo"
            android:exported="true"
            android:theme="@style/Theme.SirosSDKSample">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SirosSDKSample">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OAuth redirect callback (custom scheme) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="siros-sample" android:host="callback" />
            </intent-filter>

            <!-- OID4VCI credential offer deep links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openid-credential-offer" />
            </intent-filter>

            <!-- OID4VP presentation request deep links. "mdoc-openid4vp" is
                 ISO 18013-7 Annex B's mdoc-specific scheme, using the same
                 wire shape as plain "openid4vp". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openid4vp" />
                <data android:scheme="mdoc-openid4vp" />
            </intent-filter>

            <!-- HAIP (High Assurance Interoperability Profile) presentation request deep links.
                 "haip" is the scheme from early HAIP drafts (1-3), which mandated a single
                 scheme; HAIP 1.0 final replaced it with separate haip-vp (presentation) and
                 haip-vci (issuance) schemes, both MAY-level. Kept "haip" too since it's cheap
                 to keep supporting and some ecosystems may still emit it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="haip" />
                <data android:scheme="haip-vp" />
            </intent-filter>

            <!-- HAIP 1.0 final credential-issuance deep links (see haip-vp comment above). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="haip-vci" />
            </intent-filter>

            <!-- USB FIDO2 authenticator (YubiKey) auto-permission -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- The Digital Credentials API entry Activity and the ISO 18013-5
             NFC host-card-emulation Service are declared by the SDK's own
             library manifests (sdk/wallet, sdk/keystore) and merged in here;
             a host app declares nothing for them. -->

    </application>

</manifest>
